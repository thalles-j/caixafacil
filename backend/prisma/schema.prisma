generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RLS, triggers, views, constraints parciais e extensoes do Neon/Postgres
// permanecem na migration SQL, pois nao possuem representacao completa no DSL.

model users {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.Citext
  password_hash String
  token_version Int      @default(0)
  role          String   @default("client")
  status        String   @default("active")
  name          String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
}

model admin_audit_logs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id String?  @db.Uuid
  target_user_id String  @db.Uuid
  action        String
  details       Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([admin_user_id, created_at(sort: Desc)], map: "idx_admin_audit_admin_created")
  @@index([target_user_id, created_at(sort: Desc)], map: "idx_admin_audit_target_created")
}

model password_reset_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at(sort: Desc)], map: "idx_password_reset_tokens_user_created")
}

model business_settings {
  user_id              String   @id @db.Uuid
  business_name        String
  business_category    String
  offering             String   @default("ambos")
  controls_stock       Boolean  @default(true)
  daily_sales_goal     Decimal? @db.Decimal(14, 2)
  report_frequency     String   @default("nenhum")
  report_by_email      Boolean  @default(false)
  report_email         String?  @db.Citext
  view_period          String   @default("day")
  onboarding_completed Boolean  @default(false)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)
}

model categories {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @default(dbgenerated("app_current_user_id()")) @db.Uuid
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, id], map: "uq_categories_tenant_id")
}

model products {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String                   @default(dbgenerated("app_current_user_id()")) @db.Uuid
  category_id      String?                  @db.Uuid
  kind             String                   @default("product")
  name             String
  barcode          String?
  sale_price       Decimal                  @default(0) @db.Decimal(14, 2)
  cost_price       Decimal                  @default(0) @db.Decimal(14, 2)
  stock_quantity   Decimal?                 @db.Decimal(14, 3)
  minimum_quantity Decimal?                 @db.Decimal(14, 3)
  service_duration Unsupported("interval")?
  active           Boolean                  @default(true)
  created_at       DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at       DateTime                 @default(now()) @db.Timestamptz(6)

  @@unique([user_id, id], map: "uq_products_tenant_id")
  @@index([user_id, active], map: "idx_products_user_active")
  @@index([user_id, category_id], map: "idx_products_user_category")
  @@unique([user_id, barcode], map: "uq_products_user_barcode")
}

model customers {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @default(dbgenerated("app_current_user_id()")) @db.Uuid
  name       String
  phone      String?
  email      String?  @db.Citext
  notes      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, id], map: "uq_customers_tenant_id")
}

model cash_sessions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @default(dbgenerated("app_current_user_id()")) @db.Uuid
  responsible      String
  opened_at        DateTime  @default(now()) @db.Timestamptz(6)
  closed_at        DateTime? @db.Timestamptz(6)
  opening_balance  Decimal   @default(0) @db.Decimal(14, 2)
  closing_balance  Decimal?  @db.Decimal(14, 2)
  expected_balance Decimal?  @db.Decimal(14, 2)
  difference       Decimal?  @default(dbgenerated()) @db.Decimal(14, 2)
  status           String    @default("open")
  notes            String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([user_id, id], map: "uq_cash_sessions_tenant_id")
  @@index([user_id, opened_at(sort: Desc)], map: "idx_cash_sessions_user_opened")
}

model sales {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @default(dbgenerated("app_current_user_id()")) @db.Uuid
  cash_session_id String?   @db.Uuid
  customer_id     String?   @db.Uuid
  description     String?
  payment_method  String
  status          String    @default("completed")
  total_amount    Decimal   @db.Decimal(14, 2)
  sold_at         DateTime  @default(now()) @db.Timestamptz(6)
  cancelled_at    DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([user_id, id], map: "uq_sales_tenant_id")
  @@index([user_id, sold_at(sort: Desc)], map: "idx_sales_user_sold")
  @@index([user_id, cash_session_id, sold_at(sort: Desc)], map: "idx_sales_user_session_sold")
  @@index([user_id, customer_id, sold_at(sort: Desc)], map: "idx_sales_user_customer_sold")
  @@index([user_id, payment_method, status], map: "idx_sales_user_payment_status")
}

model sale_items {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @default(dbgenerated("app_current_user_id()")) @db.Uuid
  sale_id      String   @db.Uuid
  product_id   String?  @db.Uuid
  product_name String
  quantity     Decimal  @db.Decimal(14, 3)
  unit_price   Decimal  @db.Decimal(14, 2)
  unit_cost    Decimal  @default(0) @db.Decimal(14, 2)
  total_amount Decimal  @default(dbgenerated()) @db.Decimal(14, 2)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, id], map: "uq_sale_items_tenant_id")
  @@index([user_id, sale_id], map: "idx_sale_items_user_sale")
  @@index([user_id, product_id], map: "idx_sale_items_user_product")
}

model fixed_expenses {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @default(dbgenerated("app_current_user_id()")) @db.Uuid
  description   String
  amount        Decimal   @db.Decimal(14, 2)
  recurrence    String    @default("monthly")
  starts_on     DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  ends_on       DateTime? @db.Date
  next_due_date DateTime? @db.Date
  due_day       Int?      @db.SmallInt
  active        Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([user_id, id], map: "uq_fixed_expenses_tenant_id")
  @@index([user_id, active, next_due_date], map: "idx_fixed_expenses_user_active_due")
}

model credit_sales {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @default(dbgenerated("app_current_user_id()")) @db.Uuid
  sale_id     String    @db.Uuid
  customer_id String    @db.Uuid
  amount      Decimal   @db.Decimal(14, 2)
  paid_amount Decimal   @default(0) @db.Decimal(14, 2)
  status      String    @default("pendente")
  due_date    DateTime? @db.Date
  paid_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([user_id, id], map: "uq_credit_sales_tenant_id")
  @@unique([user_id, sale_id], map: "uq_credit_sales_tenant_sale")
  @@index([user_id, status, due_date], map: "idx_credit_sales_user_status_due")
  @@index([user_id, customer_id, status], map: "idx_credit_sales_user_customer_status")
  @@index([user_id, created_at(sort: Desc)], map: "idx_credit_sales_user_created")
}

model transactions {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String   @default(dbgenerated("app_current_user_id()")) @db.Uuid
  cash_session_id        String?  @db.Uuid
  sale_id                String?  @db.Uuid
  fixed_expense_id       String?  @db.Uuid
  credit_sale_id         String?  @db.Uuid
  type                   String
  source                 String
  payment_method         String   @default("dinheiro")
  amount                 Decimal  @db.Decimal(14, 2)
  description            String?
  movement_kind          String   @default("regular")
  entry_kind             String?
  expense_kind           String?
  identification_pending Boolean  @default(false)
  occurred_at            DateTime @default(now()) @db.Timestamptz(6)
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  @@unique([user_id, id], map: "uq_transactions_tenant_id")
  @@index([user_id, occurred_at(sort: Desc)], map: "idx_transactions_user_occurred")
  @@index([user_id, cash_session_id, occurred_at(sort: Desc)], map: "idx_transactions_user_session_occurred")
  @@index([user_id, source, occurred_at(sort: Desc)], map: "idx_transactions_user_source_occurred")
}
