# Neon Postgres (URL pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=verify-full

# Segredos distintos, aleatórios e longos.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# API, frontend e CORS (aceita origens separadas por vírgula).
PORT=3000
BACKEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Webhook HTTPS que recebe { from, to, subject, text, html? }.
EMAIL_WEBHOOK_URL=https://email-adapter.example.com/send
EMAIL_WEBHOOK_TOKEN=replace-with-webhook-token
EMAIL_FROM=CaixaFácil <noreply@example.com>
SUPPORT_EMAIL=suporte@example.com

# Opcionais em produção.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
# RUN_DB_MIGRATIONS_ON_STARTUP=true
# REFRESH_COOKIE_SAME_SITE=none

# Observabilidade (opcional). Não envie PII para o projeto do Sentry.
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
# APP_RELEASE=caixafacil@1.0.0

# Retorno autenticado do monitor externo para o painel administrativo.
# UPTIME_REPORT_TOKEN=replace-with-a-long-random-token
