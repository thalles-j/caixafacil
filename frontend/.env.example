# URL pública da API. O frontend é executado e publicado separadamente.
VITE_API_URL=http://localhost:3000/api
# Opcional no desenvolvimento local quando VITE_API_URL=/api.
# O alvo é configurado no próprio frontend, sem ler o .env do backend.
# VITE_API_PROXY_TARGET=http://localhost:3000

# Endereço exibido como alternativa quando o formulário de suporte falhar.
VITE_SUPPORT_EMAIL=suporte@example.com

# Observabilidade (opcional). O frontend remove query strings e dados livres.
# VITE_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
# VITE_APP_RELEASE=caixafacil@1.0.0
